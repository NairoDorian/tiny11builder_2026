# Windows tooling: keep CRLF in the working tree on every platform.
* text=auto
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.xml  text eol=crlf
*.json text eol=crlf
*.txt  text eol=crlf
*.md   text eol=crlf
*.yml  text eol=crlf
*.cs   text eol=crlf
*.ico  binary
*.png  binary
