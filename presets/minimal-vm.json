{
    "name": "Minimal-VM",
    "description": "Ultra-lightweight preset stripped for virtual machines, testing, and lab environments",
    "debloat": {
        "removeAppx": true,
        "removeCapabilities": true,
        "removeWindowsPackages": true,
        "removeOneDrive": true,
        "removeAI": true,
        "removeEdge": true,
        "removeStore": true,
        "removeDefender": true
    },
    "privacy": {
        "disableTelemetry": true,
        "disableAds": true,
        "disableSponsoredApps": true,
        "disableThirdPartyTelemetry": true,
        "blockFirewallTelemetry": true,
        "disableZoneInformation": true
    },
    "performance": {
        "enableUltimatePerformance": true,
        "tuneMouseLatency": true,
        "tuneDefenderCpuLimit": true,
        "disableMouseAcceleration": true,
        "enableUtcClock": true,
        "enableFastShutdown": true,
        "enableDriverBlocklist": false
    }
}
