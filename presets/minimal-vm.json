{
    "name": "Minimal-VM",
    "description": "Smallest footprint for disposable VMs and labs: also removes Store, WebView2 and Defender (no antivirus!)",
    "debloat": {
        "removeAppx": true,
        "removeCapabilities": true,
        "removeOneDrive": true,
        "removeEdge": true,
        "removeWebView": true,
        "removeAI": true,
        "removeStore": true,
        "removeDefender": true,
        "keepXbox": false
    },
    "privacy": {
        "disableTelemetry": true,
        "disableAds": true,
        "disableSponsoredApps": true,
        "disableThirdPartyTelemetry": true,
        "blockFirewallTelemetry": true,
        "disableZoneInformation": true,
        "disableDefenderCloud": false
    },
    "performance": {
        "enableUltimatePerformance": true,
        "enableFastShutdown": true,
        "disableMouseAcceleration": false,
        "enableUtcClock": false,
        "tuneDefenderCpuLimit": false,
        "enableDriverBlocklist": false
    }
}
