{
    "name": "Gaming",
    "description": "Default choices plus Xbox/Game Bar kept, raw mouse input and telemetry firewall rules; Defender stays on",
    "debloat": {
        "removeAppx": true,
        "removeCapabilities": true,
        "removeOneDrive": true,
        "removeEdge": true,
        "removeWebView": false,
        "removeAI": true,
        "removeStore": false,
        "removeDefender": false,
        "keepXbox": true
    },
    "privacy": {
        "disableTelemetry": true,
        "disableAds": true,
        "disableSponsoredApps": true,
        "disableThirdPartyTelemetry": true,
        "blockFirewallTelemetry": true,
        "disableZoneInformation": false,
        "disableDefenderCloud": false
    },
    "performance": {
        "enableUltimatePerformance": true,
        "enableFastShutdown": true,
        "disableMouseAcceleration": true,
        "enableUtcClock": false,
        "tuneDefenderCpuLimit": true,
        "enableDriverBlocklist": true
    }
}
