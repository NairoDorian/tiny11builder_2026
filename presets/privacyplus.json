{
    "name": "PrivacyPlus",
    "description": "Default choices plus telemetry firewall rules and no Defender cloud reporting/sample submission; Defender stays on, no Ultimate Performance plan",
    "debloat": {
        "removeAppx": true,
        "removeCapabilities": true,
        "removeOneDrive": true,
        "removeEdge": true,
        "removeWebView": false,
        "removeAI": true,
        "removeStore": false,
        "removeDefender": false,
        "keepXbox": false
    },
    "privacy": {
        "disableTelemetry": true,
        "disableAds": true,
        "disableSponsoredApps": true,
        "disableThirdPartyTelemetry": true,
        "blockFirewallTelemetry": true,
        "disableZoneInformation": false,
        "disableDefenderCloud": true
    },
    "performance": {
        "enableUltimatePerformance": false,
        "enableFastShutdown": true,
        "disableMouseAcceleration": false,
        "enableUtcClock": false,
        "tuneDefenderCpuLimit": true,
        "enableDriverBlocklist": true
    }
}
