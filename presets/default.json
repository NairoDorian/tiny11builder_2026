{
    "name": "Default",
    "description": "Balanced tiny11: removes bloat, Edge, OneDrive and AI features; keeps Store, Defender and WebView2",
    "debloat": {
        "removeAppx": true,
        "removeCapabilities": true,
        "removeOneDrive": true,
        "removeEdge": true,
        "removeWebView": false,
        "removeAI": true,
        "removeStore": false,
        "removeDefender": false,
        "keepXbox": false
    },
    "privacy": {
        "disableTelemetry": true,
        "disableAds": true,
        "disableSponsoredApps": true,
        "disableThirdPartyTelemetry": true,
        "blockFirewallTelemetry": false,
        "disableZoneInformation": false,
        "disableDefenderCloud": false
    },
    "performance": {
        "enableUltimatePerformance": false,
        "enableFastShutdown": false,
        "disableMouseAcceleration": false,
        "enableUtcClock": false,
        "tuneDefenderCpuLimit": true,
        "enableDriverBlocklist": true
    }
}
